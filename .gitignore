.installed.cfg
*.egg

# Virtual environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ==========================================
# Data & Results (Heavy files)
# ==========================================
# Ignore raw and processed data if not using Git LFS
data/raw/
data/processed/
data/results/

# Ignore common data file extensions
*.bag
*.db3
*.mcap
*.csv
*.json
*.xlsx
*.h5
*.pkl
*.parquet

# ==========================================
# YOLO / Model Weights (Heavy files)
# ==========================================
# Ignore model weight files - document download links in README instead
*.pt
*.pth
*.onnx

# ==========================================
# IDE & Editor
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~

# ==========================================
# Operating System
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
