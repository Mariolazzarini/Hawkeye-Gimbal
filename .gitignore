# ==========================================
# ROS 2 / Colcon Build Artifacts
# ==========================================
build/
install/
log/
devel/
logs/

# ==========================================
# Python
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
# Anchored so that a future source directory named lib/ is not silently hidden
/lib/
/lib64/

# Virtual environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ==========================================
# Data & Results (Heavy files)
# ==========================================
# Ignore the contents, but keep the directory structure the README documents
# and the scripts expect (tools/evaluator.py and optimization/run_npsoSSPID.py
# write here).
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/results/*
!data/results/.gitkeep

# Common data file extensions, scoped to data/ so that configuration files
# elsewhere in the tree are not ignored by accident.
data/**/*.bag
data/**/*.db3
data/**/*.mcap
data/**/*.csv
data/**/*.json
data/**/*.xlsx
data/**/*.h5
data/**/*.pkl
data/**/*.parquet

# ==========================================
# YOLO / Model Weights (Heavy files)
# ==========================================
# Not tracked; see the Installation section of the README for the download link.
*.pt
*.pth
*.onnx

# ==========================================
# IDE & Editor
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~

# ==========================================
# Operating System
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
*.key
*.pem
